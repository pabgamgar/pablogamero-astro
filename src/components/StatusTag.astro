---
const {
    lang = "en",
    endpoint = "https://admin.pablogamero.com/api/status",
    fallback,
    href,
} = Astro.props as {
    lang?: "en" | "es";
    endpoint?: string;
    fallback?: string;
    href?: string;
};
const fallbackText =
    fallback ?? (lang === "es" ? "Actualizando..." : "Updating...");
const Tag = href ? "a" : "p";
---

<div class="flex min-h-6 w-full items-center justify-center">
    <Tag
        href={href}
        class:list={[
            "group/status px-2.5 py-0.5 rounded-full bg-[var(--content)] w-fit flex gap-2 items-center justify-center text-sm text-center self-center sm:self-auto whitespace-nowrap",
            href &&
                "border border-transparent hover:border-[var(--border)] transition-colors duration-150",
        ]}
        data-status-tag
        data-lang={lang}
        data-endpoint={endpoint}
    >
        <span
            class="relative inline-flex rounded-full size-2 bg-green-500"
            data-status-dot
        >
            <span
                class="animate-ping motion-reduce:animate-none inline-flex size-full rounded-full bg-green-400 opacity-75"
                data-status-ping
            >
            </span>
        </span>
        <span data-status-text aria-live="polite">{fallbackText}</span>
        {
            href && (
                <>
                    <span
                        aria-hidden="true"
                        class="text-[var(--teal)] transition-transform duration-300 group-hover/status:translate-x-0.5 motion-reduce:transition-none"
                    >
                        →
                    </span>
                    <span class="sr-only">
                        {lang === "es" ? "(qué hago ahora)" : "(what I'm up to now)"}
                    </span>
                </>
            )
        }
    </Tag>
</div>
<script is:inline>
    (() => {
        const tags = document.querySelectorAll("[data-status-tag]");
        if (!tags.length) return;

        const COLOR_CLASSES = {
            green: ["bg-green-500", "bg-green-400"],
            red: ["bg-red-500", "bg-red-400"],
            blue: ["bg-blue-500", "bg-blue-400"],
            orange: ["bg-orange-500", "bg-orange-400"],
            yellow: ["bg-yellow-400", "bg-yellow-300"],
            purple: ["bg-purple-500", "bg-purple-400"],
            gray: ["bg-gray-400", "bg-gray-300"],
        };

        const STATUS_COLORS = {
            building: "green",
            shipping: "green",
            debugging: "red",
            planning: "blue",
            experimenting: "blue",
            researching: "blue",
            learning: "blue",
            "evaluating app idea": "blue",
            writing: "purple",
            "client work": "orange",
            "client meeting": "orange",
            admin: "yellow",
            recharging: "gray",
        };

        const setDotColor = (dot, ping, color) => {
            if (!color || !COLOR_CLASSES[color]) return;
            Object.values(COLOR_CLASSES).forEach(([dotClass, pingClass]) => {
                dot.classList.remove(dotClass);
                ping.classList.remove(pingClass);
            });
            const [dotClass, pingClass] = COLOR_CLASSES[color];
            dot.classList.add(dotClass);
            ping.classList.add(pingClass);
        };

        tags.forEach((el) => {
            const lang = el.getAttribute("data-lang") || "en";
            const endpoint = el.getAttribute("data-endpoint");
            if (!endpoint) return;
            const textEl = el.querySelector("[data-status-text]");
            const dotEl = el.querySelector("[data-status-dot]");
            const pingEl = el.querySelector("[data-status-ping]");

            const markOffline = () => {
                if (dotEl && pingEl) {
                    setDotColor(dotEl, pingEl, "gray");
                    pingEl.classList.add("hidden");
                }
            };

            fetch(endpoint, { headers: { Accept: "application/json" } })
                .then((res) => (res.ok ? res.json() : null))
                .then((data) => {
                    if (!data) return markOffline();
                    const statusKey =
                        typeof data.key === "string" ? data.key : null;
                    const current =
                        data.current && typeof data.current === "object"
                            ? data.current[lang] || data.current.en
                            : data.current;
                    if (typeof current === "string" && current.trim()) {
                        if (textEl) {
                            textEl.textContent = current;
                        }
                    }
                    if (dotEl && pingEl) {
                        const color = statusKey
                            ? STATUS_COLORS[statusKey]
                            : null;
                        if (color) setDotColor(dotEl, pingEl, color);
                    }
                })
                .catch(markOffline);
        });
    })();
</script>
