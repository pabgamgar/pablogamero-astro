---
interface Props {
    lang: "en" | "es";
}

const { lang } = Astro.props;

// `fan` offsets pull the outer icons toward the centre so they overlap until hovered.
const products = [
    {
        name: "CareDose",
        href: "https://caredose.pablogamero.com",
        icon: "/images/caredose-icon-128.webp",
        desc: {
            en: "Medication reminders and dose tracking",
            es: "Recordatorios de medicación y seguimiento de dosis",
        },
        fan: "translate-x-[1.125rem]",
    },
    {
        name: "Dibs",
        href: "https://dibs.pablogamero.com",
        icon: "/images/dibs-icon-128.webp",
        desc: { en: "A simple debt tracker", es: "Un gestor de deudas simple" },
        fan: "translate-x-1.5",
    },
    {
        name: "Pubmefy",
        href: "https://pubmefy.vercel.app",
        icon: "/images/pubmefy-icon-128.webp",
        desc: {
            en: "Automated CVs for researchers",
            es: "CVs automatizados para investigadores",
        },
        fan: "-translate-x-1.5",
    },
    {
        name: "Submoney",
        href: "https://submoney.pablogamero.com",
        icon: "/images/submoney-icon-128.webp",
        desc: {
            en: "A simple subscription tracker",
            es: "Un gestor de suscripciones simple",
        },
        fan: "-translate-x-[1.125rem]",
    },
];
---

<ul class="flex gap-2">
    {
        products.map((p) => (
            <li>
                <a
                    href={p.href}
                    aria-label={`${p.name} — ${p.desc[lang]}`}
                    class:list={[
                        "group/icon relative block rounded-lg",
                        "-rotate-6 group-hover/projects:translate-x-0 group-hover/projects:rotate-0",
                        "group-focus-within/projects:translate-x-0 group-focus-within/projects:rotate-0",
                        "transition-transform duration-300 motion-reduce:transition-none",
                        p.fan,
                    ]}
                >
                    <img
                        src={p.icon}
                        alt=""
                        width="128"
                        height="128"
                        class="size-10 rounded-lg"
                    />
                    <span
                        aria-hidden="true"
                        class="pointer-events-none absolute bottom-full left-1/2 mb-2 hidden w-max max-w-[14rem] -translate-x-1/2 text-balance rounded-xl bg-black/80 px-2.5 py-1 text-xs text-white opacity-0 transition-opacity group-hover/icon:opacity-100 group-focus-visible/icon:opacity-100 sm:block">
                        {p.name} — {p.desc[lang]}
                    </span>
                </a>
            </li>
        ))
    }
</ul>
