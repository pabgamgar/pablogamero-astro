---
import MainLayout from "@/layouts/MainLayout.astro";
import BackButton from "@/components/BackButton.astro";
---

<MainLayout
    title="Brand Identity • Pablo Gamero"
    desc="The visual and verbal identity for Pablo Gamero — colors, typography, voice, and motion. Point people or AI here when building anything under the Pablo Gamero name."
    kw="Pablo Gamero, brand identity, brand guidelines, design system, colors, typography, voice"
    canon="https://pablogamero.com/brand"
    robots="noindex, nofollow"
>
    <div id="content" class="brand w-full max-w-5xl px-4 sm:px-6 md:px-8">
        <BackButton />

        <!-- MASTHEAD -->
        <header class="masthead">
            <span class="status-pill"><span class="dot"></span> building Limero</span>
            <h1 class="title">Build.<br />Learn.<br /><em>Repeat.</em></h1>
            <p class="lede">
                The visual &amp; verbal identity for Pablo Gamero — a builder who
                learns by building, and documents the process. Calm, considered,
                and quietly its own thing, with <span class="spark"
                    >one warm spark</span
                >.
            </p>
            <div class="meta-row">
                <span><b>Signature</b> teal #61CCBA</span>
                <span><b>Accent</b> coral #FF7A5C</span>
                <span><b>Voice</b> calm · considered · minimal</span>
            </div>
        </header>

        <!-- 01 THE IDEA -->
        <section>
            <div class="sec-head"><span class="num">01</span><h2>The idea</h2></div>
            <p class="idea">
                This isn't a portfolio or a pitch — it's an honest, dated
                snapshot of what I'm working on, changing direction on, and
                learning. Everything here is written for a <em
                    >peer, not a lead</em
                >. The identity should feel the same way: confident enough to
                stay quiet, warm enough to feel human.
            </p>
        </section>

        <!-- 02 COLOR -->
        <section>
            <div class="sec-head"><span class="num">02</span><h2>Color</h2></div>
            <p class="sec-intro">
                A dark teal world. Teal is the signature and carries structure
                &amp; interaction. Coral is the single warm accent — used <b
                    class="c-soft">rarely</b
                >, as emphasis. Neutrals are teal-biased greys, never a default
                #808080.
            </p>

            <div class="swatches">
                <div class="swatch">
                    <div class="chip" style="background:#001414"></div>
                    <div class="info">
                        <div class="name">Ink</div>
                        <div class="hex">#001414</div>
                        <div class="use">Primary background</div>
                    </div>
                </div>
                <div class="swatch">
                    <div class="chip" style="background:#0c2624"></div>
                    <div class="info">
                        <div class="name">Surface</div>
                        <div class="hex">#0C2624</div>
                        <div class="use">Cards, raised areas</div>
                    </div>
                </div>
                <div class="swatch">
                    <div class="chip" style="background:#61ccba"></div>
                    <div class="info">
                        <div class="name">Teal · signature</div>
                        <div class="hex">#61CCBA</div>
                        <div class="use">Links, brand, accent</div>
                    </div>
                </div>
                <div class="swatch">
                    <div class="chip" style="background:#3e9e8e"></div>
                    <div class="info">
                        <div class="name">Teal deep</div>
                        <div class="hex">#3E9E8E</div>
                        <div class="use">Hover, teal on light</div>
                    </div>
                </div>
                <div class="swatch">
                    <div class="chip" style="background:#4b98ca"></div>
                    <div class="info">
                        <div class="name">Blue · support</div>
                        <div class="hex">#4B98CA</div>
                        <div class="use">Rare cool second</div>
                    </div>
                </div>
                <div class="swatch">
                    <div class="chip" style="background:#ff7a5c"></div>
                    <div class="info">
                        <div class="name">Coral · spark</div>
                        <div class="hex">#FF7A5C</div>
                        <div class="use">Rare emphasis only</div>
                    </div>
                </div>
                <div class="swatch">
                    <div class="chip" style="background:#f1f1f1"></div>
                    <div class="info">
                        <div class="name">Text</div>
                        <div class="hex">#F1F1F1</div>
                        <div class="use">Primary text</div>
                    </div>
                </div>
                <div class="swatch">
                    <div class="chip" style="background:#8ca3a0"></div>
                    <div class="info">
                        <div class="name">Muted</div>
                        <div class="hex">#8CA3A0</div>
                        <div class="use">Teal-biased grey</div>
                    </div>
                </div>
            </div>

            <div class="rule-card">
                <span class="tag">The rule</span>
                <p>
                    Coral is a <b>spark, not a system color.</b> If it appears
                    more than once or twice on a screen, remove some. Its
                    scarcity is what makes it read as warmth instead of noise —
                    like this callout, the only coral on the page so far.
                </p>
            </div>

            <div class="grounds">
                <div class="ground dark">
                    <div class="lbl">On ink</div>
                    <div class="demo">
                        I'm running <a class="t" href="#">Limero</a>, where I
                        work on real operational problems. <span class="cc"
                            >→ New</span
                        >
                    </div>
                </div>
                <div class="ground light">
                    <div class="lbl">On paper #EFF3F2</div>
                    <div class="demo">
                        I'm running <a class="t" href="#">Limero</a>, where I
                        work on real operational problems. <span class="cc"
                            >→ New</span
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- 03 TYPE -->
        <section>
            <div class="sec-head">
                <span class="num">03</span><h2>Typography</h2>
            </div>
            <p class="sec-intro">
                <strong>Fraunces</strong> (serif) for headings — warm, writerly,
                calm with quiet character. <strong>Satoshi</strong> for everything
                read. A monospace for data and hex.
            </p>

            <div class="specimen">
                <div class="spec-row">
                    <div class="spec-meta"><b>Display</b>Fraunces · 3rem · 500</div>
                    <div class="s-display">Build. Learn. <em>Repeat.</em></div>
                </div>
                <div class="spec-row">
                    <div class="spec-meta"><b>H1</b>Fraunces · 2rem · 500</div>
                    <div class="s-h1">
                        Things I've built, am building, or discontinued
                    </div>
                </div>
                <div class="spec-row">
                    <div class="spec-meta"><b>H2</b>Fraunces · 1.55rem · 500</div>
                    <div class="s-h2">Independent projects</div>
                </div>
                <div class="spec-row">
                    <div class="spec-meta"><b>H3</b>Satoshi · 1.15rem · 600</div>
                    <div class="s-h3">A simple debt tracker</div>
                </div>
                <div class="spec-row">
                    <div class="spec-meta"><b>Body</b>Satoshi · 1rem · 400</div>
                    <div class="s-body">
                        Most of my time goes into Limero, a long-term project
                        where I use technology to reduce friction in real
                        businesses — by working closely with the problems
                        themselves, not by applying predefined solutions.
                    </div>
                </div>
                <div class="spec-row">
                    <div class="spec-meta"><b>Label</b>Satoshi · 0.75rem · 600</div>
                    <div class="s-label">Currently · Updated Jan 12</div>
                </div>
            </div>
        </section>

        <!-- 04 VOICE -->
        <section>
            <div class="sec-head"><span class="num">04</span><h2>Voice</h2></div>
            <p class="sec-intro">
                Calm, considered, minimal. First person, present tense, say the
                true thing plainly. Show, don't sell.
            </p>

            <div class="voice-grid">
                <div class="voice-col do">
                    <h3>Sounds like me</h3>
                    <div class="voice-list">
                        <div class="voice-item">A simple debt tracker.</div>
                        <div class="voice-item">
                            Not a pitch — just an honest snapshot over time.
                        </div>
                        <div class="voice-item">
                            Things I've built, am building, or discontinued.
                        </div>
                    </div>
                </div>
                <div class="voice-col dont">
                    <h3>Never</h3>
                    <div class="voice-list">
                        <div class="voice-item">
                            Revolutionize the way you track debt!
                        </div>
                        <div class="voice-item">
                            The #1 tool trusted by thousands.
                        </div>
                        <div class="voice-item">
                            Unlock your productivity today 🚀
                        </div>
                    </div>
                </div>
            </div>

            <div class="principles">
                <div class="principle">
                    <b>Short sentences</b><span
                        >Say the true thing plainly. Length is not depth.</span
                    >
                </div>
                <div class="principle">
                    <b>Honest state</b><span
                        >Shipped, paused, discontinued — no "coming soon"
                        theater.</span
                    >
                </div>
                <div class="principle">
                    <b>Peer, not lead</b><span
                        >Written for another builder, never for a prospect.</span
                    >
                </div>
                <div class="principle">
                    <b>No hype</b><span
                        >No buzzwords, no growth-speak, exclamation marks ≈
                        never.</span
                    >
                </div>
            </div>
        </section>

        <!-- 05 SHAPE & MOTION -->
        <section>
            <div class="sec-head">
                <span class="num">05</span><h2>Shape &amp; motion</h2>
            </div>
            <div class="sm-grid">
                <div>
                    <div class="s-label mb">Radius</div>
                    <div class="radii">
                        <div class="radius-demo">
                            <div class="box" style="border-radius:8px"></div>
                            <div class="cap">sm · 8</div>
                        </div>
                        <div class="radius-demo">
                            <div class="box" style="border-radius:12px"></div>
                            <div class="cap">md · 12</div>
                        </div>
                        <div class="radius-demo">
                            <div class="box" style="border-radius:16px"></div>
                            <div class="cap">lg · 16</div>
                        </div>
                        <div class="radius-demo">
                            <div class="box" style="border-radius:9999px"></div>
                            <div class="cap">pill</div>
                        </div>
                    </div>
                    <div class="fan" title="Hover me">
                        <div class="ic">D</div>
                        <div class="ic">P</div>
                        <div class="ic">S</div>
                    </div>
                    <p class="fan-cap">
                        Signature moment: the project icons settle into place on
                        hover. One delight per view.
                    </p>
                </div>
                <div>
                    <div class="s-label mb">Motion</div>
                    <div class="motion-list">
                        <div class="motion-item">
                            <span>Micro (color, opacity)</span><span class="mono"
                                >150ms</span
                            >
                        </div>
                        <div class="motion-item">
                            <span>Standard (transform)</span><span class="mono"
                                >300ms</span
                            >
                        </div>
                        <div class="motion-item">
                            <span>Deliberate reveals</span><span class="mono"
                                >500ms</span
                            >
                        </div>
                        <div class="motion-item">
                            <span>Easing</span><span class="mono"
                                >cubic-bezier(.4,0,.2,1)</span
                            >
                        </div>
                        <div class="motion-item">
                            <span>Borders</span><span class="mono"
                                >1px teal @15%</span
                            >
                        </div>
                    </div>
                    <p class="motion-note">
                        Subtle and purposeful. Always honor <span class="mono"
                            >prefers-reduced-motion</span
                        >.
                    </p>
                </div>
            </div>
        </section>

        <!-- USAGE -->
        <section class="last">
            <div class="usage">
                <span class="eyebrow">Using this identity</span>
                <h2>Point people — or AI — here</h2>
                <p>
                    This page is the canonical reference. When building anything
                    under the Pablo Gamero name in another project, share this
                    URL and follow the sections above.
                </p>
                <div class="codeblock">
                    My brand identity lives at <span class="k"
                        >pablogamero.com/brand</span
                    >.<br />
                    Follow its color, type, voice &amp; motion exactly.<br />
                    When in doubt, choose the <span class="k">calmer, quieter</span
                    > option.<br />
                    Coral appears <span class="k">once</span> per view — at most.
                </div>
            </div>
        </section>
    </div>
</MainLayout>

<style>
    .brand {
        /* Shared identity tokens are defined globally in MainLayout's :root
           (--font-*, --teal*, --coral*, --blue, --surface, --border, --muted,
           --faint) and inherited here. Only brand-page-specific tokens live below. */
        --display: var(--font-display);
        --body: var(--font-body);
        --mono: var(--font-mono);
        --ink: #001414;
        --surface-2: #103330;
        --border-strong: rgba(97, 204, 186, 0.28);
        --text: #f1f1f1;
        --paper: #eff3f2;
        --paper-text: #0a1f1d;
        --paper-muted: #4a5f5c;
        --maxw: 68ch;

        display: flex;
        flex-direction: column;
        gap: 0;
        color: var(--text);
        line-height: 1.65;
        text-align: left;
    }

    .brand p {
        max-width: var(--maxw);
    }
    .brand a {
        color: var(--teal);
        text-decoration: none;
    }
    .brand strong {
        color: var(--text);
        font-weight: 600;
    }
    .brand .mono {
        font-family: var(--mono);
        font-variant-numeric: tabular-nums;
    }

    /* masthead */
    .masthead {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
        padding: 2rem 0 clamp(2.5rem, 6vw, 4rem);
        border-bottom: 1px solid var(--border);
    }
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        align-self: flex-start;
        padding: 0.3rem 0.85rem;
        border-radius: 9999px;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid var(--border);
        font-family: var(--body);
        font-size: 0.85rem;
    }
    .dot {
        position: relative;
        width: 8px;
        height: 8px;
        border-radius: 9999px;
        background: #22c55e;
    }
    .dot::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 9999px;
        background: #4ade80;
        opacity: 0.75;
        animation: ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    @keyframes ping {
        75%,
        100% {
            transform: scale(2.2);
            opacity: 0;
        }
    }
    .title {
        font-family: var(--display);
        font-size: clamp(2.6rem, 7vw, 4.4rem);
        line-height: 1.02;
        letter-spacing: -0.025em;
        font-weight: 500;
    }
    .title em {
        font-style: italic;
        color: var(--teal);
    }
    .lede {
        font-family: var(--body);
        font-size: clamp(1.05rem, 2.2vw, 1.25rem);
        color: var(--muted);
        max-width: 52ch;
    }
    .spark {
        color: var(--coral);
        font-style: italic;
    }
    .meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 2.5rem;
        font-family: var(--mono);
        font-size: 0.8rem;
        color: var(--faint);
    }
    .meta-row b {
        color: var(--muted);
        font-weight: 400;
    }

    /* sections */
    .brand section {
        padding: clamp(2.75rem, 7vw, 5rem) 0;
        border-bottom: 1px solid var(--border);
    }
    .brand section.last {
        border-bottom: none;
    }
    .sec-head {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        margin-bottom: 1.75rem;
    }
    .sec-head .num {
        font-family: var(--mono);
        font-size: 0.8rem;
        color: var(--teal-deep);
    }
    .sec-head h2 {
        font-family: var(--display);
        font-size: clamp(1.5rem, 3.5vw, 2rem);
        font-weight: 500;
    }
    .sec-intro {
        color: var(--muted);
        margin-bottom: 2.25rem;
        font-family: var(--body);
    }
    .sec-intro .c-soft {
        color: var(--coral-soft);
    }
    .idea {
        font-family: var(--display);
        font-size: clamp(1.15rem, 2.6vw, 1.4rem);
        line-height: 1.5;
        max-width: 58ch;
    }
    .idea em {
        color: var(--teal);
        font-style: italic;
    }

    /* color */
    .swatches {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 0.75rem;
    }
    .swatch {
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        background: var(--surface);
    }
    .swatch .chip {
        height: 72px;
    }
    .swatch .info {
        padding: 0.6rem 0.75rem 0.75rem;
        font-family: var(--body);
    }
    .swatch .name {
        font-size: 0.82rem;
        font-weight: 600;
    }
    .swatch .hex {
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--muted);
        text-transform: uppercase;
    }
    .swatch .use {
        font-size: 0.72rem;
        color: var(--faint);
        margin-top: 0.35rem;
        line-height: 1.4;
    }
    .rule-card {
        margin-top: 1.75rem;
        display: flex;
        gap: 0.9rem;
        align-items: flex-start;
        padding: 1rem 1.15rem;
        border-radius: 12px;
        background: rgba(255, 122, 92, 0.06);
        border: 1px solid rgba(255, 122, 92, 0.22);
    }
    .rule-card .tag {
        font-family: var(--body);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--coral);
        white-space: nowrap;
        padding-top: 0.2rem;
    }
    .rule-card p {
        font-family: var(--body);
        font-size: 0.92rem;
        color: var(--coral-soft);
    }
    .rule-card p b {
        color: #ffd3c6;
        font-weight: 600;
    }
    .grounds {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        margin-top: 1.25rem;
    }
    .ground {
        border-radius: 12px;
        padding: 1.25rem;
        border: 1px solid var(--border);
        font-family: var(--body);
    }
    .ground.dark {
        background: var(--ink);
    }
    .ground.light {
        background: var(--paper);
    }
    .ground .lbl {
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
        font-weight: 600;
    }
    .ground.dark .lbl {
        color: var(--muted);
    }
    .ground.light .lbl {
        color: var(--paper-muted);
    }
    .ground .demo {
        font-size: 0.95rem;
    }
    .ground.dark .demo {
        color: var(--text);
    }
    .ground.light .demo {
        color: var(--paper-text);
    }
    .ground.dark .demo a.t {
        color: var(--teal);
        font-weight: 600;
    }
    .ground.light .demo a.t {
        color: var(--teal-deep);
        font-weight: 600;
    }
    .ground .demo .cc {
        color: var(--coral);
        font-weight: 600;
    }

    /* type */
    .specimen {
        display: flex;
        flex-direction: column;
    }
    .spec-row {
        display: grid;
        grid-template-columns: 96px 1fr;
        gap: 1.25rem;
        align-items: baseline;
        border-top: 1px solid var(--border);
        padding: 1.5rem 0;
    }
    .spec-row:first-child {
        border-top: none;
        padding-top: 0;
    }
    .spec-meta {
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--faint);
        line-height: 1.5;
    }
    .spec-meta b {
        color: var(--muted);
        font-weight: 400;
        display: block;
    }
    .s-display {
        font-family: var(--display);
        font-size: clamp(2rem, 5vw, 2.75rem);
        line-height: 1.05;
        letter-spacing: -0.025em;
        font-weight: 500;
    }
    .s-display em {
        font-style: italic;
        color: var(--teal);
    }
    .s-h1 {
        font-family: var(--display);
        font-size: 1.9rem;
        line-height: 1.15;
        font-weight: 500;
    }
    .s-h2 {
        font-family: var(--display);
        font-size: 1.5rem;
        font-weight: 500;
    }
    .s-h3 {
        font-family: var(--body);
        font-size: 1.15rem;
        font-weight: 600;
    }
    .s-body {
        font-family: var(--body);
        font-size: 1rem;
        line-height: 1.65;
        color: #dfe6e4;
        max-width: 60ch;
    }
    .s-label {
        font-family: var(--body);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
    }
    .s-label.mb {
        margin-bottom: 1.25rem;
    }

    /* voice */
    .voice-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
    .voice-col h3 {
        font-family: var(--body);
        font-size: 0.78rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 1rem;
        font-weight: 700;
    }
    .voice-col.do h3 {
        color: var(--teal);
    }
    .voice-col.dont h3 {
        color: var(--coral);
    }
    .voice-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }
    .voice-item {
        font-family: var(--display);
        font-size: 1.05rem;
        line-height: 1.4;
        font-style: italic;
        padding: 0.85rem 1rem;
        border-radius: 8px;
        border: 1px solid var(--border);
    }
    .voice-col.do .voice-item {
        background: rgba(97, 204, 186, 0.05);
    }
    .voice-col.dont .voice-item {
        background: rgba(255, 122, 92, 0.05);
        color: var(--muted);
        text-decoration: line-through;
        text-decoration-color: rgba(255, 122, 92, 0.4);
    }
    .principles {
        margin-top: 2.5rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.25rem 2rem;
    }
    .principle {
        border-top: 2px solid var(--teal-deep);
        padding-top: 0.85rem;
    }
    .principle b {
        display: block;
        font-family: var(--body);
        font-size: 0.95rem;
        margin-bottom: 0.3rem;
    }
    .principle span {
        font-family: var(--body);
        font-size: 0.85rem;
        color: var(--muted);
    }

    /* shape & motion */
    .sm-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }
    .radii {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: flex-end;
    }
    .radius-demo {
