---
import MainLayout from "@/layouts/MainLayout.astro";
import BackButton from "@/components/BackButton.astro";
import { Image } from "astro:assets";
import { inspiration } from "@/content/data";
---

<MainLayout
  title="About Me • Pablo Gamero"
  desc="Discover more about me, my path, what I'm working on now, and why I do it."
  kw="Pablo Gamero, Pablo Gamero García, about, developer, entrepreneur"
  canon="https://pablogamero.com/about"
  alt="https://pablogamero.com/es/sobre-mi"
>
  <div
    id="content"
    class="about w-full max-w-3xl px-4 sm:px-6 md:px-8 flex flex-col gap-14"
  >
    <BackButton />

    <!-- HERO -->
    <header class="flex flex-col sm:flex-row gap-7 sm:gap-9 items-start w-full">
      <div class="photo">
        <Image
          src="/images/professional-me.webp"
          alt="Pablo Gamero"
          width="400"
          height="400"
          class="w-full h-full object-cover"
          fetchpriority="high"
          loading="eager"
        />
      </div>
      <div class="flex flex-col gap-4 flex-1">
        <h1>Build. Learn. Repeat.</h1>
        <p class="lead">
          I'm Pablo Gamero, I love building software that removes busywork.
        </p>
        <a
          href="/now"
          class="currently"
        >
          <span class="dot"></span>
          <span>Currently building Limero</span>
          <span class="arrow">→</span>
        </a>
      </div>
    </header>

    <!-- THE WORK -->
    <section class="prose">
      <p>
        Most of my time goes into <a href="/projects/limero">Limero</a>, a
        long-term project where I use technology to reduce friction in real
        businesses — by working closely with the problems themselves, not by
        applying predefined solutions.
      </p>
      <p>
        Alongside that, I build my own products: apps, web tools, and small
        experiments that help me test ideas and sharpen my judgment.
      </p>
      <p>
        This website is where I keep track of that process — what I'm working
        on, what I'm changing direction on, and what I'm learning along the way.
        It's not a portfolio or a pitch, just an honest snapshot over time.
      </p>
    </section>

    <!-- OUTSIDE THE SCREEN -->
    <section class="block">
      <span class="eyebrow">Outside the screen</span>
      <p class="prose">
        I play piano and guitar, train fitboxing, and try to keep enough
        distance from screens to think clearly. The time away from the keyboard
        is usually where the better ideas show up.
      </p>
    </section>

    <!-- INFLUENCES -->
    <section class="block">
      <span class="eyebrow">Who I learn from</span>
      <ul class="influences">
        {
          inspiration.map((person) => (
            <li>
              <span class="name">{person.name}</span>
              <span class="desc">{person.desc.en}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</MainLayout>

<style>
  .about {
    text-align: left;
    line-height: 1.65;
  }

  .photo {
    width: 100%;
    max-width: 220px;
    aspect-ratio: 1;
    border-radius: 16px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }
  @media (min-width: 640px) {
    .photo {
      width: 200px;
    }
  }

  .lead {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.4;
    color: var(--text, #f1f1f1);
  }

  .currently {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    align-self: flex-start;
    margin-top: 0.25rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--border);
    color: #e6ecea;
    font-size: 0.85rem;
    transition:
      border-color 250ms ease,
      color 250ms ease;
  }
  .currently:hover {
    border-color: var(--border-strong, rgba(97, 204, 186, 0.28));
    color: #fff;
  }
  .currently .dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18);
  }
  .currently .arrow {
    color: var(--teal);
    transition: transform 250ms ease;
  }
  .currently:hover .arrow {
    transform: translateX(3px);
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 62ch;
    color: #dfe6e4;
  }
  .prose a {
    color: var(--teal);
    text-decoration: none;
    font-style: italic;
  }
  .prose a:hover {
    color: #7bd8c8;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .influences {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 62ch;
  }
  .influences li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border-left: 2px solid var(--teal-deep);
    padding-left: 0.9rem;
  }
  .influences .name {
    font-weight: 600;
    color: var(--text, #f1f1f1);
  }
  .influences .desc {
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
