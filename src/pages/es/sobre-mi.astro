---
import MainLayout from "@/layouts/MainLayout.astro";
import BackButton from "@/components/BackButton.astro";
import { Image } from "astro:assets";

const inspiracion = [
    {
        name: "Ali Abdaal",
        desc: "Ex-médico y youtuber centrado en la productividad y en disfrutar del proceso.",
    },
    {
        name: "Tiago Forte",
        desc: "Creador del método PARA para organizar nuestras ideas y pensamientos.",
    },
];
---

<MainLayout
    title="Sobre mí • Pablo Gamero"
    desc="Descubre más sobre mí, mi camino, en qué trabajo ahora y por qué lo hago."
    kw="Pablo Gamero, Pablo Gamero García, about, developer, entrepreneur"
    canon="https://pablogamero.com/es/sobre-mi"
    alt="https://pablogamero.com/about"
    lang="es"
>
    <div
        id="content"
        class="about w-full max-w-3xl px-4 sm:px-6 md:px-8 flex flex-col gap-14"
    >
        <BackButton link="/es" text="Volver a inicio" />

        <!-- HERO -->
        <header
            class="flex flex-col sm:flex-row gap-7 sm:gap-9 items-start w-full"
        >
            <div class="photo">
                <Image
                    src="/images/professional-me.webp"
                    alt="Pablo Gamero"
                    width="400"
                    height="400"
                    class="w-full h-full object-cover"
                    fetchpriority="high"
                    loading="eager"
                />
            </div>
            <div class="flex flex-col gap-4 flex-1">
                <h1>Construir. Aprender. Repetir.</h1>
                <p class="lead">Soy Pablo Gamero y aprendo construyendo.</p>
                <a href="/es/ahora" class="currently">
                    <span class="dot"></span>
                    <span>Construyendo Limero ahora</span>
                    <span class="arrow">→</span>
                </a>
            </div>
        </header>

        <!-- EL TRABAJO -->
        <section class="prose">
            <p>
                La mayor parte de mi tiempo se va en <a
                    href="/es/proyectos/limero">Limero</a
                >, un proyecto a largo plazo donde uso la tecnología para reducir
                la fricción en negocios reales trabajando de cerca con los
                problemas mismos, no aplicando soluciones predefinidas.
            </p>
            <p>
                Además, construyo mis propios productos: apps, herramientas web y
                pequeños experimentos que me ayudan a probar ideas y mejorar mi
                criterio.
            </p>
            <p>
                Esta web es donde llevo el registro de ese proceso — en qué
                trabajo, dónde cambio de dirección y qué aprendo por el camino.
                No es un portafolio ni un pitch, solo una instantánea honesta en
                el tiempo.
            </p>
        </section>

        <!-- FUERA DE LA PANTALLA -->
        <section class="block">
            <span class="eyebrow">Fuera de la pantalla</span>
            <p class="prose">
                Toco el piano y la guitarra, entreno fitboxing e intento mantener
                suficiente distancia de las pantallas para pensar con claridad.
                El tiempo lejos del teclado suele ser donde aparecen las mejores
                ideas.
            </p>
        </section>

        <!-- INFLUENCIAS -->
        <section class="block">
            <span class="eyebrow">De quién aprendo</span>
            <ul class="influences">
                {
                    inspiracion.map((person) => (
                        <li>
                            <span class="name">{person.name}</span>
                            <span class="desc">{person.desc}</span>
                        </li>
                    ))
                }
            </ul>
        </section>
    </div>
</MainLayout>

<style>
    .about {
        text-align: left;
        line-height: 1.65;
    }

    .photo {
        width: 100%;
        max-width: 220px;
        aspect-ratio: 1;
        border-radius: 16px;
        overflow: hidden;
        flex-shrink: 0;
        border: 1px solid var(--border);
    }
    @media (min-width: 640px) {
        .photo {
            width: 200px;
        }
    }

    .lead {
        font-family: var(--font-display);
        font-size: 1.35rem;
        line-height: 1.4;
        color: var(--text, #f1f1f1);
    }

    .currently {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        align-self: flex-start;
        margin-top: 0.25rem;
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid var(--border);
        color: #e6ecea;
        font-size: 0.85rem;
        transition: border-color 250ms ease, color 250ms ease;
    }
    .currently:hover {
        border-color: var(--border-strong, rgba(97, 204, 186, 0.28));
        color: #fff;
    }
    .currently .dot {
        width: 8px;
        height: 8px;
        border-radius: 9999px;
        background: #22c55e;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18);
    }
    .currently .arrow {
        color: var(--teal);
        transition: transform 250ms ease;
    }
    .currently:hover .arrow {
        transform: translateX(3px);
    }

    .prose {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 62ch;
        color: #dfe6e4;
    }
    .prose a {
        color: var(--teal);
        text-decoration: none;
        font-style: italic;
    }
    .prose a:hover {
        color: #7bd8c8;
    }

    .block {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }
    .eyebrow {
        font-family: var(--font-body);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .influences {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        max-width: 62ch;
    }
    .influences li {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        border-left: 2px solid var(--teal-deep);
        padding-left: 0.9rem;
    }
    .influences .name {
        font-weight: 600;
        color: var(--text, #f1f1f1);
    }
    .influences .desc {
        font-size: 0.9rem;
        color: var(--muted);
    }
</style>
