---
import LangSelector from "@/components/LangSelector.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import StatusTag from "@/components/StatusTag.astro";
import ProductIcons from "@/components/ProductIcons.astro";
import status from "@/content/status.json";
---

<MainLayout
    title="Pablo Gamero"
    desc="Pablo Gamero — Aprendo construyendo productos y trabajando en problemas de negocio reales."
    kw="Pablo Gamero, Pablo Gamero García, building in public, Limero, Pubmefy, Dibs, developer, entrepreneur"
    canon="https://pablogamero.com/es"
    alt="https://pablogamero.com"
    lang="es"
>
    <LangSelector />
    <div
        id="content"
        class="flex w-full flex-col gap-12 items-center flex-1 justify-center px-2 pb-8 max-w-xl text-center"
    >
        <div class="flex flex-col gap-3 items-center">
            <h1 class="text-center flex flex-col">
                <span class="font-normal text-2xl">Hola, soy </span>
                <span class="text-3xl">Pablo Gamero</span>
            </h1>
            <StatusTag lang="es" fallback={status.current.es} href="/es/ahora" />
        </div>
        <div class="flex flex-col items-center gap-3 group/projects">
            <p class="text-2xl">
                Desarrollo productos para problemas específicos
            </p>
            <ProductIcons lang="es" />
        </div>
        <p class="text-2xl text-balance group/limero">
            También dirijo <a
                href="https://limero.co"
                class="font-medium group-hover/limero:text-[var(--teal)] transition-colors duration-500 italic"
                >Limero</a
            >, donde trabajo con pequeñas empresas en problemas operativos
            reales.
        </p>
        <nav class="flex gap-6 pt-4 text-sm text-white/60">
            <a href="/es/proyectos" class="hover:text-white/90 transition">
                Proyectos
            </a>
            <a href="/es/blog" class="hover:text-white/90 transition"> Blog </a>
            <a href="/es/sobre-mi" class="hover:text-white/90 transition">
                Sobre mí
            </a>
        </nav>
    </div>
</MainLayout>
